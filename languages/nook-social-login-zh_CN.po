msgstr "重定向 URL"

#: includes/class-nsl-admin.php:315
msgid "Copy"
msgstr "复制"

#: includes/class-nsl-auth.php:113
#: includes/class-nsl-auth.php:159
msgid "This login method is not available."
msgstr "此登录方式不可用。"

#: includes/class-nsl-auth.php:121
msgid "The link has expired. Please try again."
msgstr "链接已过期，请重试。"

#: includes/class-nsl-auth.php:169
#: includes/class-nsl-auth.php:420
msgid "The login session has expired or was opened in another browser. Please try again."
msgstr "登录会话已过期或在其他浏览器中打开，请重试。"

#. translators: %s: provider name.
#: includes/class-nsl-auth.php:195
#, php-format
msgid "This %s account is already linked to another user."
msgstr "此 %s 账户已关联到其他用户。"

#. translators: %s: provider name.
#: includes/class-nsl-auth.php:199
#, php-format
msgid "%s account linked."
msgstr "已关联 %s 账户。"

#. translators: %s: provider name.
#: includes/class-nsl-auth.php:217
#: includes/class-nsl-auth.php:436
#, php-format
msgid "An account with this e-mail address already exists. Log in with your password and link %s in your profile."
msgstr "使用此电子邮件的账户已存在。请使用密码登录，并在个人资料中关联 %s。"

#: includes/class-nsl-auth.php:225
msgid "Registration through social networks is disabled on this site. Log in with your password and link the account in your profile."
msgstr "本站已禁用通过社交平台注册。请使用密码登录，并在个人资料中关联账户。"

#: includes/class-nsl-auth.php:295
msgid "Login is not allowed for this account."
msgstr "此账户不允许登录。"

#: includes/class-nsl-auth.php:430
msgid "Please enter a valid e-mail address."
msgstr "请输入有效的电子邮件地址。"

#: includes/class-nsl-auth.php:447
msgid "Enter your e-mail"
msgstr "输入电子邮件"

#. translators: 1: user name, 2: provider name.
#: includes/class-nsl-auth.php:467
#, php-format
msgid "Hello, %1$s! %2$s did not share your e-mail address. Enter it to finish registration."
msgstr "你好，%1$s！%2$s 未提供你的电子邮件地址。请输入以完成注册。"

#: includes/class-nsl-auth.php:475
msgid "E-mail"
msgstr "电子邮件"

#: includes/class-nsl-auth.php:480
msgid "Continue"
msgstr "继续"

#: includes/class-nsl-buttons.php:125
msgid "Link a social account"
msgstr "关联社交账户"

#: includes/class-nsl-buttons.php:125
msgid "or log in with"
msgstr "或使用以下方式登录"

#. translators: %s: provider name.
#: includes/class-nsl-buttons.php:137
#: includes/class-nsl-profile.php:86
#, php-format
msgid "Link %s"
msgstr "关联 %s"

#. translators: %s: provider name.
#: includes/class-nsl-buttons.php:139
#, php-format
msgid "Log in with %s"
msgstr "使用 %s 登录"

#: includes/class-nsl-buttons.php:204
msgid "or register with"
msgstr "或使用以下方式注册"

#: includes/class-nsl-buttons.php:224
msgid "Log in to comment:"
msgstr "登录后发表评论："

#: includes/class-nsl-oauth2-provider.php:131
#: includes/providers/class-nsl-provider-steam.php:142
msgid "Login was cancelled."
msgstr "登录已取消。"

#: includes/class-nsl-oauth2-provider.php:137
msgid "The authorization code is missing."
msgstr "缺少授权码。"

#: includes/class-nsl-oauth2-provider.php:149
#: includes/providers/class-nsl-provider-twitch.php:99
#: includes/providers/class-nsl-provider-vk.php:140
msgid "The provider did not return a user ID."
msgstr "提供方未返回用户 ID。"

#: includes/class-nsl-oauth2-provider.php:194
msgid "The provider did not return an access token."
msgstr "提供方未返回访问令牌。"

#: includes/class-nsl-plugin.php:73
msgid "Settings"
msgstr "设置"

#: includes/class-nsl-profile.php:46
msgid "Social accounts"
msgstr "社交账户"

#: includes/class-nsl-profile.php:61
msgid "Linked:"
msgstr "已关联："

#: includes/class-nsl-profile.php:81
msgid "Unlink"
msgstr "解除关联"

#: includes/class-nsl-profile.php:90
msgid "Not linked"
msgstr "未关联"

#: includes/class-nsl-profile.php:107
msgid "Sorry, you are not allowed to edit this user."
msgstr "抱歉，你无权编辑此用户。"

#: includes/class-nsl-profile.php:116
msgid "This is the only way to log in to this account. Add an e-mail address first so that a password can be set."
msgstr "这是登录此账户的唯一方式。请先添加电子邮件地址以便设置密码。"

#. translators: %s: provider name.
#: includes/class-nsl-profile.php:124
#, php-format
msgid "%s account unlinked."
msgstr "已解除关联 %s 账户。"

