#. Description of the plugin
#: nook-social-login.php
msgid "Registration and login via VK ID, Steam, Battle.net, Yandex ID, Google, Twitch and Discord."
msgstr "通过 VK ID、Steam、Battle.net、Yandex ID、Google、Twitch 和 Discord 注册和登录。"

#. Author of the plugin
#: nook-social-login.php
msgid "Горшков Сергей Владимирович"
msgstr ""

#: includes/class-nsl-admin.php:31
#: includes/class-nsl-admin.php:32
#: includes/class-nsl-admin.php:159
msgid "Social Login"
msgstr "社交登录"

#: includes/class-nsl-admin.php:66
msgid "Copied"
msgstr "已复制"

#: includes/class-nsl-admin.php:160
msgid "Let visitors register and log in with VK ID, Steam, Battle.net, Yandex ID, Google, Twitch and Discord. Enable a network, create an application in its developer console with the redirect URL shown below and paste the keys."
msgstr "访客可以通过 VK ID、Steam、Battle.net、Yandex ID、Google、Twitch 和 Discord 注册和登录。启用某个平台，在其开发者控制台中使用下方的重定向 URL 创建应用，然后粘贴密钥。"

#: includes/class-nsl-admin.php:165
msgid "Social networks"
msgstr "社交平台"

#: includes/class-nsl-admin.php:172
msgid "General"
msgstr "常规"

#: includes/class-nsl-admin.php:175
msgid "Registration"
msgstr "注册"

#: includes/class-nsl-admin.php:178
msgid "Create a new account on the first login"
msgstr "首次登录时创建新账户"

#: includes/class-nsl-admin.php:178
msgid "Works even when \"Anyone can register\" is turned off in General Settings."
msgstr "即使在常规设置中关闭了“任何人都可以注册”也有效。"

#: includes/class-nsl-admin.php:179
msgid "Ask for an e-mail when the network does not share it (Steam, Battle.net)"
msgstr "当平台不提供电子邮件时要求填写（Steam、Battle.net）"

#: includes/class-nsl-admin.php:180
msgid "Link to an existing account with the same confirmed e-mail"
msgstr "关联到具有相同已验证电子邮件的现有账户"

#: includes/class-nsl-admin.php:180
msgid "Administrators and user managers are never linked automatically: they link networks in their profile."
msgstr "管理员和用户管理者不会被自动关联：他们需要在个人资料中关联社交平台。"

#: includes/class-nsl-admin.php:185
msgid "Role of new users"
msgstr "新用户角色"

#: includes/class-nsl-admin.php:195
msgid "Redirect after login"
msgstr "登录后跳转"

#: includes/class-nsl-admin.php:198
msgid "Leave empty to return the user to the page where the button was clicked."
msgstr "留空则返回点击按钮时所在的页面。"

#: includes/class-nsl-admin.php:202
msgid "Show buttons"
msgstr "显示按钮"

#: includes/class-nsl-admin.php:205
msgid "On the login form"
msgstr "在登录表单上"

#: includes/class-nsl-admin.php:206
msgid "On the registration form"
msgstr "在注册表单上"

#: includes/class-nsl-admin.php:207
msgid "Above the comment form for guests"
msgstr "在访客评论表单上方"

#: includes/class-nsl-admin.php:208
msgid "On WooCommerce login and registration forms"
msgstr "在 WooCommerce 登录和注册表单上"

#. translators: 1: shortcode, 2: shortcode with attributes.
#: includes/class-nsl-admin.php:214
#, php-format
msgid "Anywhere else: shortcode %1$s, for example %2$s. Use link=\"1\" to let logged-in users link more networks."
msgstr "其他位置：使用短代码 %1$s，例如 %2$s。添加 link=\"1\" 可让已登录用户关联更多平台。"

#: includes/class-nsl-admin.php:223
msgid "Button style"
msgstr "按钮样式"

#: includes/class-nsl-admin.php:226
msgid "Icon and text"
msgstr "图标和文字"

#: includes/class-nsl-admin.php:227
msgid "Icons only"
msgstr "仅图标"

#: includes/class-nsl-admin.php:232
msgid "Other"
msgstr "其他"

#: includes/class-nsl-admin.php:235
msgid "Use the social network avatar"
msgstr "使用社交平台头像"

#: includes/class-nsl-admin.php:236
msgid "Delete linked accounts data when the plugin is deleted"
msgstr "删除插件时删除已关联账户的数据"

#. translators: 1: plugin version, 2: author name, 3: author site link.
#: includes/class-nsl-admin.php:249
#, php-format
