#: includes/class-nsl-admin.php:31
#: includes/class-nsl-admin.php:32
#: includes/class-nsl-admin.php:159
msgid "Social Login"
msgstr "Вход через соцсети"

#: includes/class-nsl-admin.php:66
msgid "Copied"
msgstr "Скопировано"

#: includes/class-nsl-admin.php:160
msgid "Let visitors register and log in with VK ID, Steam, Battle.net, Yandex ID, Google, Twitch and Discord. Enable a network, create an application in its developer console with the redirect URL shown below and paste the keys."
msgstr "Посетители смогут регистрироваться и входить через VK ID, Steam, Battle.net, Яндекс ID, Google, Twitch и Discord. Включите соцсеть, создайте приложение в её консоли разработчика с указанным ниже адресом перенаправления и вставьте ключи."

#: includes/class-nsl-admin.php:165
msgid "Social networks"
msgstr "Социальные сети"

#: includes/class-nsl-admin.php:172
msgid "General"
msgstr "Общие"

#: includes/class-nsl-admin.php:175
msgid "Registration"
msgstr "Регистрация"

#: includes/class-nsl-admin.php:178
msgid "Create a new account on the first login"
msgstr "Создавать новый аккаунт при первом входе"

#: includes/class-nsl-admin.php:178
msgid "Works even when \"Anyone can register\" is turned off in General Settings."
msgstr "Работает, даже если в общих настройках выключено «Любой может зарегистрироваться»."

#: includes/class-nsl-admin.php:179
msgid "Ask for an e-mail when the network does not share it (Steam, Battle.net)"
msgstr "Запрашивать e-mail, если соцсеть его не передаёт (Steam, Battle.net)"

#: includes/class-nsl-admin.php:180
msgid "Link to an existing account with the same confirmed e-mail"
msgstr "Привязывать к существующему аккаунту с тем же подтверждённым e-mail"

#: includes/class-nsl-admin.php:180
msgid "Administrators and user managers are never linked automatically: they link networks in their profile."
msgstr "Администраторы и управляющие пользователями никогда не привязываются автоматически — они привязывают соцсети в своём профиле."

#: includes/class-nsl-admin.php:185
msgid "Role of new users"
msgstr "Роль новых пользователей"

#: includes/class-nsl-admin.php:195
msgid "Redirect after login"
msgstr "Перенаправление после входа"

#: includes/class-nsl-admin.php:198
msgid "Leave empty to return the user to the page where the button was clicked."
msgstr "Оставьте пустым, чтобы вернуть пользователя на страницу, где была нажата кнопка."

#: includes/class-nsl-admin.php:202
msgid "Show buttons"
msgstr "Показывать кнопки"

#: includes/class-nsl-admin.php:205
msgid "On the login form"
msgstr "На форме входа"

#: includes/class-nsl-admin.php:206
msgid "On the registration form"
msgstr "На форме регистрации"

#: includes/class-nsl-admin.php:207
msgid "Above the comment form for guests"
msgstr "Над формой комментариев для гостей"

#: includes/class-nsl-admin.php:208
msgid "On WooCommerce login and registration forms"
msgstr "На формах входа и регистрации WooCommerce"

#. translators: 1: shortcode, 2: shortcode with attributes.
#: includes/class-nsl-admin.php:214
#, php-format
msgid "Anywhere else: shortcode %1$s, for example %2$s. Use link=\"1\" to let logged-in users link more networks."
msgstr "В любом другом месте: шорткод %1$s, например %2$s. Добавьте link=\"1\", чтобы вошедшие пользователи могли привязать другие соцсети."

#: includes/class-nsl-admin.php:223
msgid "Button style"
msgstr "Стиль кнопок"

#: includes/class-nsl-admin.php:226
msgid "Icon and text"
msgstr "Иконка и текст"

#: includes/class-nsl-admin.php:227
msgid "Icons only"
msgstr "Только иконки"

#: includes/class-nsl-admin.php:232
msgid "Other"
msgstr "Прочее"

#: includes/class-nsl-admin.php:235
msgid "Use the social network avatar"
msgstr "Использовать аватар из соцсети"

#: includes/class-nsl-admin.php:236
msgid "Delete linked accounts data when the plugin is deleted"
msgstr "Удалять данные привязанных аккаунтов при удалении плагина"

#. translators: 1: plugin version, 2: author name, 3: author site link.
#: includes/class-nsl-admin.php:249
#, php-format
msgid "Nook Social Login %1$s · Author: %2$s · Site: %3$s"
msgstr "Nook Social Login %1$s · Автор: %2$s · Сайт: %3$s"

#: includes/class-nsl-admin.php:251
msgid "Gorshkov Sergey Vladimirovich"
msgstr "Горшков Сергей Владимирович"

#: includes/class-nsl-admin.php:269
msgid "Active"
msgstr "Активно"

#: includes/class-nsl-admin.php:272
msgid "Keys are missing"
msgstr "Не указаны ключи"

#: includes/class-nsl-admin.php:275
msgid "Off"
msgstr "Выключено"

#: includes/class-nsl-admin.php:287
msgid "Enabled"
msgstr "Включено"

#: includes/class-nsl-admin.php:291
msgid "Open the developer console"
msgstr "Открыть консоль разработчика"

#: includes/class-nsl-admin.php:312
msgid "Return URL (informational)"
msgstr "Адрес возврата (для справки)"

#: includes/class-nsl-admin.php:312
msgid "Redirect URL"
msgstr "Адрес перенаправления (Redirect URL)"

#: includes/class-nsl-admin.php:315
msgid "Copy"
msgstr "Копировать"

#: includes/class-nsl-auth.php:113
#: includes/class-nsl-auth.php:159
msgid "This login method is not available."
msgstr "Этот способ входа недоступен."

#: includes/class-nsl-auth.php:121
msgid "The link has expired. Please try again."
msgstr "Срок действия ссылки истёк. Попробуйте ещё раз."

#: includes/class-nsl-auth.php:169
#: includes/class-nsl-auth.php:420
msgid "The login session has expired or was opened in another browser. Please try again."
msgstr "Сессия входа истекла или была открыта в другом браузере. Попробуйте ещё раз."

#. translators: %s: provider name.
#: includes/class-nsl-auth.php:195
#, php-format
msgid "This %s account is already linked to another user."
msgstr "Этот аккаунт %s уже привязан к другому пользователю."

#. translators: %s: provider name.
#: includes/class-nsl-auth.php:199
#, php-format
msgid "%s account linked."
msgstr "Аккаунт %s привязан."

#. translators: %s: provider name.
#: includes/class-nsl-auth.php:217
#: includes/class-nsl-auth.php:436
#, php-format
msgid "An account with this e-mail address already exists. Log in with your password and link %s in your profile."
msgstr "Аккаунт с этим e-mail уже существует. Войдите с паролем и привяжите %s в профиле."

#: includes/class-nsl-auth.php:225
msgid "Registration through social networks is disabled on this site. Log in with your password and link the account in your profile."
msgstr "Регистрация через соцсети на этом сайте отключена. Войдите с паролем и привяжите аккаунт в профиле."

#: includes/class-nsl-auth.php:295
msgid "Login is not allowed for this account."
msgstr "Для этого аккаунта вход запрещён."

#: includes/class-nsl-auth.php:430
msgid "Please enter a valid e-mail address."
msgstr "Введите корректный e-mail."

#: includes/class-nsl-auth.php:447
msgid "Enter your e-mail"
msgstr "Введите e-mail"

#. translators: 1: user name, 2: provider name.
#: includes/class-nsl-auth.php:467
#, php-format
msgid "Hello, %1$s! %2$s did not share your e-mail address. Enter it to finish registration."
msgstr "Здравствуйте, %1$s! %2$s не передал ваш e-mail. Укажите его, чтобы завершить регистрацию."

#: includes/class-nsl-auth.php:475
msgid "E-mail"
msgstr "E-mail"

#: includes/class-nsl-auth.php:480
msgid "Continue"
msgstr "Продолжить"

