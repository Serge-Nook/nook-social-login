msgid "Link a social account"
msgstr "Привязать соцсеть"

#: includes/class-nsl-buttons.php:125
msgid "or log in with"
msgstr "или войдите через"

#. translators: %s: provider name.
#: includes/class-nsl-buttons.php:137
#: includes/class-nsl-profile.php:86
#, php-format
msgid "Link %s"
msgstr "Привязать %s"

#. translators: %s: provider name.
#: includes/class-nsl-buttons.php:139
#, php-format
msgid "Log in with %s"
msgstr "Войти через %s"

#: includes/class-nsl-buttons.php:204
msgid "or register with"
msgstr "или зарегистрируйтесь через"

#: includes/class-nsl-buttons.php:224
